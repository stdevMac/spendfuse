# Spendfuse environment. Copy to .env (chmod 600) and fill in. Never commit .env.
# npm run setup creates the *_KEY values and the account ids it needs; you only have to supply OWNER_*.

# --- accounts and keys (testnet) ---
# owner account id (e.g. you.testnet); default parent for every vault.<owner>, agent.<owner> ... id below
OWNER_ID=
# owner full-access secret key (ed25519:...); signs setup, approvals, unfreeze, policy updates
OWNER_KEY=
# vault contract account (default vault.<OWNER_ID>)
VAULT_ID=
# vault full-access secret key; used by setup to deploy, deleted by npm run lockdown (then remove this line)
VAULT_KEY=
# agent account (default agent.<OWNER_ID>); holds only a function-call key on the vault
AGENT_ID=
# agent function-call secret key (vault methods only)
AGENT_KEY=
# guardian account (default guardian.<OWNER_ID>); may only reject / freeze / pause
GUARDIAN_ID=
# guardian secret key; the dashboard uses it when OWNER_KEY is not set
GUARDIAN_KEY=
# allowlisted demo payee (default store.<OWNER_ID>)
SHOP_ID=
# demo API-provider payee (default billing.<OWNER_ID>)
API_ID=
# demo data-vendor payee (default feed.<OWNER_ID>); also the stand-in attacker
DATA_ID=
# optional: override the attack demo's stand-in attacker account (default DATA_ID)
ATTACKER_ID=

# --- agent model ---
# scripted (offline, default) | nearai | openrouter
LLM_MODE=scripted
# NEAR AI Cloud API key (LLM_MODE=nearai)
NEARAI_API_KEY=
# optional: NEAR AI Cloud base URL (default https://cloud-api.near.ai/v1)
NEARAI_BASE_URL=
# optional: comma-separated accepted TDX TCB statuses for attestation (--attest)
NEARAI_ACCEPTED_TCB=
# optional: comma-separated pinned compose hashes for attestation (--attest)
NEARAI_PINNED_COMPOSE_HASHES=
# OpenRouter API key (LLM_MODE=openrouter)
OPENROUTER_API_KEY=

# --- dashboard (npm run dashboard) ---
# bind host (default 127.0.0.1)
HOST=
# port (default 8787)
PORT=
# 1 or true: public read-only mode, all POST actions disabled
READONLY=
